# Firebase Web SDK configuration for the dashboard.
# These values are public browser identifiers, not secrets. Never put a
# service-account JSON key or a server API key in this file.
#
# JSON object: app identifier -> Firebase Web App configuration.
# The app key must match the backend app name (the service-account filename
# under ../credentials without the .json extension).
VITE_FIREBASE_CONFIGS='{"create_app":{"apiKey":"demo-api-key","authDomain":"demo-project.firebaseapp.com","projectId":"demo-project","appId":"1:000000000000:web:0000000000000000000000"}}'

# App used for Firebase sign-in. If omitted, the first key in the map is used.
VITE_DEFAULT_APP=create_app
