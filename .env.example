# --- Required ---
# Comma-separated explicit browser origins. Empty, invalid or "*" prevents startup.
# Example: https://admin.example.com,http://localhost:5173
CORS_ALLOWED_ORIGINS=

# --- Authentication ---
# Server-to-server key. Optional; when empty the service-key path is disabled.
# Generate outside the repository and never ship it to a client.
SERVICE_API_KEY=

# Legacy API_KEY compatibility for /send only. Keep false except during migration.
LEGACY_API_KEY_ENABLED=false
API_KEY=

# --- Networking ---
# Only enable when running behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
PORT=8080

# --- Database ---
DATABASE_URL=sqlite://data.db
