# --- Required ---
# Comma-separated explicit browser origins. Empty, invalid or "*" prevents startup.
# Example: https://admin.example.com,http://localhost:5173
CORS_ALLOWED_ORIGINS=

# --- Authentication ---
# Server-to-server key. Optional; when empty the service-key path is disabled.
# Generate outside the repository and never ship it to a client.
SERVICE_API_KEY=

# Legacy API_KEY compatibility for /send only. Keep false except during migration.
LEGACY_API_KEY_ENABLED=false
API_KEY=
# The budget of the legacy key: requests per minute, for every caller together.
# 0 or a value that is not a number keeps the default of 60 and warns at startup.
LEGACY_RATE_LIMIT_PER_MINUTE=60

# --- Networking ---
# Only enable when running behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
PORT=8080

# --- Dashboard sessions (T2) ---
# Set to false only for local HTTP development; the cookie then drops `Secure`
# and uses the plain `fcm_session` name instead of `__Host-fcm_session`.
COOKIE_SECURE=true
# Absolute dashboard session lifetime in hours: 12 by default, never above 72.
ADMIN_SESSION_HOURS=12

# --- Database ---
DATABASE_URL=sqlite://data.db

# --- Credential files (T16) ---
# The directory of the service account files. It must be writable by the
# container when the dashboard may install an app.
CREDENTIALS_DIR=credentials
# Set to false to manage the credential files by hand only: the dashboard
# routes that install or replace a file then answer 404.
CREDENTIALS_UPLOAD_ENABLED=true
